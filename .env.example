# Cloudflare Realtime TURN (dashboard -> Realtime -> TURN -> Create): relays voice and screen share
# when two homes cannot connect directly. Free up to 1000 GB/month
# TURN_KEY_ID=REPLACE_ME
# TURN_KEY_API_TOKEN=REPLACE_ME
# Or a static TURN such as ExpressTURN (free 1000 GB/month, no card): username/password from its dashboard
# TURN_URLS=turn:relay1.expressturn.com:3478,turn:relay1.expressturn.com:3478?transport=tcp
# TURN_USERNAME=REPLACE_ME
# TURN_PASSWORD=REPLACE_ME
